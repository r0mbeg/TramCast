[Unit]
Description=TramCast GPU forecast service (recipe 030)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
WorkingDirectory=%h/tramcast/ml/runtime
Environment=PYTHONPATH=%h/tramcast/ml/runtime/generated
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CUDA_VISIBLE_DEVICES=GPU-dc08576d-527d-8764-688e-1c69ecbc7973
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_IMPLICIT_TOKEN=1
Environment=CUDA_CACHE_PATH=%h/tramcast/ml/cache/cuda
ExecStartPre=%h/tramcast/.venv/bin/python %h/tramcast/ml/deploy/check_sandbox.py
ExecStart=%h/tramcast/.venv/bin/python service.py --config ../recipes/tabpfn-030/recipe.json --bind unix:%h/tramcast/run/forecast.sock
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
LimitCORE=0
MemoryMax=8G
# The host delegates memory/pids, but not the CPU controller, to user services.
CPUAffinity=0 1
TasksMax=128
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
PrivateUsers=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectProc=ptraceable
ProtectHome=tmpfs
InaccessiblePaths=-/run/dbus -/run/systemd/private
BindReadOnlyPaths=%h/tramcast %h/.local/share/uv/python
BindPaths=%h/tramcast/ml/cache %h/tramcast/run

[Install]
WantedBy=default.target
