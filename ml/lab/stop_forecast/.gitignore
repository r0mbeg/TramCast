# Versioned audit evidence; raw events and private identifiers are never written here.
!availability.json
!runs/*/*.json
!sources/*.json
# Reproducible bulky scenario outputs stay local; metrics/manifests stay reviewable.
runs/bayes-*/*.csv
runs/bayes-*/*.csv.gz
runs/bayes-*/*.npy
runs/shares-*/*.csv.gz
runs/preliminary-*/*.csv
runs/preliminary-*/*.csv.gz
runs/metro-*/*.csv
runs/metro-*/*.csv.gz
runs/access-*/*.csv
runs/proximity-*/*.csv
runs/proximity-*/*.csv.gz
runs/device-signal-*/*.csv
runs/device-signal-*/*.npz
runs/device-holdout-*/*.csv
runs/device-holdout-*/*.npz
runs/activity-*/*.csv
runs/activity-*/*.npz
runs/catalog-alignment-*/*.csv
runs/catalog-alignment-*/*.npz
runs/historical-geometry-*/*.csv
runs/known-counts-*/*.csv
releases/*/*.csv
releases/*/*.csv.gz
!releases/*/*.json
# Approved integration snapshot is delivered through Git, without a ZIP archive.
!releases/route12-entropy-v1/*.csv
!releases/route12-entropy-v1/*.csv.gz
