# The ML runtime verifies these files by SHA-256 and hashes its code into
# model_version. Keep the committed bytes on every platform: with Git for
# Windows defaults (core.autocrlf=true) LF would become CRLF and the recipe
# fails with "Input checksum mismatch".
ml/recipes/** -text
ml/bundles/** -text
ml/runtime/*.py eol=lf
