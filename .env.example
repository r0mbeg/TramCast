POSTGRES_USER=tramcast
POSTGRES_DB=tramcast
# Set a local password in .env before starting PostgreSQL.
# Single quotes keep $ and # literal in Docker Compose dotenv files.
POSTGRES_PASSWORD=''

# Optional host access through the dev port-forwarder; PostgreSQL itself has no published port.
POSTGRES_FORWARD_PORT=5433

# Local Go backend connection; keep PORT in sync with FORWARD_PORT above.
# In a future backend container, use POSTGRES_HOST=postgres and POSTGRES_PORT=5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=0
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_STARTUP_TIMEOUT=10s

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_PROBE_TIMEOUT=2s

LOGGER_LEVEL=INFO
# text for local development, json for structured log collection.
LOGGER_FORMAT=text

# Frontend build served by the backend. A relative path is resolved from the
# process working directory: make run-backend runs in backend/.
# In a future backend container, use an absolute path such as /app/frontend/dist.
WEB_DIR=../frontend/dist

# Reference workbook read by make import-catalog; resolved like WEB_DIR. The
# workbook contains personal data, so keep it outside Git in every environment.
CATALOG_FILE=../dataset/spravochniki/Хакатон_справочники_трамвай_10_маршрутов.xlsx

# OpenStreetMap snapshot of routes 17, 25, 26, 28, 50 read by make import-catalog;
# resolved like WEB_DIR. It is committed in data/osm; on a server it may lie
# anywhere, for example next to the workbook.
CATALOG_OSM_FILE=../data/osm/tram_routes.json
