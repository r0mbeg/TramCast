POSTGRES_USER=tramcast
POSTGRES_DB=tramcast
# Set a local password in .env before starting PostgreSQL.
# Single quotes keep $ and # literal in Docker Compose dotenv files.
POSTGRES_PASSWORD=''

# Optional host access through the dev port-forwarder; PostgreSQL itself has no published port.
POSTGRES_FORWARD_PORT=5433

# Local Go backend connection; keep PORT in sync with FORWARD_PORT above.
# Compose overrides these with postgres:5432 inside application containers.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=0
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_STARTUP_TIMEOUT=10s

# Local Go backend listener. While the compose backend runs, use 127.0.0.1:8081:
# on Windows :8080 still binds and localhost:8080 then reaches the container.
HTTP_ADDR=:8080
# Host address and port of the containerized backend. Compose fixes the
# container listener at :8080 regardless of HTTP_ADDR above.
# 127.0.0.1 keeps the app local. On a server, HTTP_BIND=0.0.0.0 with
# HTTP_PORT=80 opens http://<server IP> to everyone: there is no HTTPS or
# authentication, and Docker publishes the port past ufw rules.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_PROBE_TIMEOUT=2s

LOGGER_LEVEL=INFO
# text for local development, json for structured log collection.
LOGGER_FORMAT=text

# Relative file paths are resolved from the directory of an explicit -env-file
# (the repository root for make commands), or from the working directory without it.
# Frontend build served by the backend.
# Compose uses the image's build at /app/frontend/dist instead.
WEB_DIR=./frontend/dist

# Sanitized reference workbook read by make import-catalog; resolved like WEB_DIR.
# Compose uses the copy included in the image at /app/data/catalog/catalog.xlsx.
CATALOG_FILE=./data/catalog/catalog.xlsx

# OpenStreetMap snapshot of routes 17, 25, 26, 28, 50 read by make import-catalog;
# resolved like WEB_DIR. It is committed in data/osm.
# Compose uses the snapshot copied into the image at /app/data/osm/tram_routes.json.
CATALOG_OSM_FILE=./data/osm/tram_routes.json

# Python forecast gRPC server (host:port) for Go on the host: the prediction job
# worker of make run-backend and make forecast-version-register. make ml-up
# publishes it on 127.0.0.1; keep the port in sync with ML_PORT.
# Compose containers always use their own ml:50051; they take the timeout below.
ML_GRPC_ADDR=127.0.0.1:50051
# Deadline of one Predict call, above the 900 s compute limit of recipe 030.
ML_GRPC_TIMEOUT=930s

# Prediction job queue and its worker inside the backend process. Compose
# passes all of these to the app containers. Keep MAX_ATTEMPTS and RETRY_DELAY
# the same for every process on one database: recovery applies them.
PREDICTION_JOB_WORKER_ENABLED=true
# Claim loops, 1 to 16; the ML server builds one response at a time.
PREDICTION_JOB_WORKERS=1
# Queued plus running jobs of all versions; leave room for the 10 forecast routes.
PREDICTION_JOB_QUEUE_CAPACITY=20
# Claims of one job, retries included, 1 to 100. A failed job is never restarted.
PREDICTION_JOB_MAX_ATTEMPTS=3
# Ownership of a claimed job, whole seconds from 3s to 1h; renewed every third
# of it, and expired leases are recovered every half of it.
PREDICTION_JOB_LEASE_DURATION=60s
# Base retry delay, whole seconds up to 1h: failed attempt n waits
# RETRY_DELAY * 4^(n-1), at most 1h.
PREDICTION_JOB_RETRY_DELAY=30s
# Idle wait after an empty claim or a database error.
PREDICTION_JOB_POLL_INTERVAL=2s
# Grace for a running ML call on shutdown, 0s to 20s; a commit re-read may add
# up to 5s, within the 30s stop grace period of the compose backend. Keep it
# small on a Windows host: a console process gets about 5s after taskkill.
PREDICTION_JOB_SHUTDOWN_TIMEOUT=5s
