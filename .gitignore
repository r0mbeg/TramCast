# Frontend: sources and configs are tracked despite *.json above; dependencies
# and the build output are not.
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/tsconfig*.json
!/frontend/src/**/*.json
/frontend/node_modules/
/frontend/dist/

# OSM snapshot read by the catalog importer from CATALOG_OSM_FILE: public
# ODbL data without personal data, tracked despite *.json above.
!/data/osm/*.json

# Docs
*.pdf


# Python and local ML inputs
__pycache__/
*.pyc
.venv*/
ml/.venv*/
ml/lab/model/
ml/lab/hf-cache/
ml/lab/artifacts/*.pkl
ml/lab/artifacts/boost_comparison/*.pkl
