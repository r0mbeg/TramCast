[Unit]
Description=TramCast web and prediction worker (master 40e2adf + Unix ML patch)
Wants=tramcast-postgres.service tramcast-ml.service
After=tramcast-postgres.service tramcast-ml.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
WorkingDirectory=%h/tramcast-app/releases/40e2adf
Environment=GIN_MODE=release
ExecStart=%h/tramcast-app/releases/40e2adf/bin/tramcast -env-file %h/tramcast-app/app.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
LimitCORE=0
MemoryMax=1G
TasksMax=128
CPUAffinity=2 3
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET
PrivateUsers=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectProc=ptraceable
ProtectHome=tmpfs
InaccessiblePaths=-/run/dbus -/run/systemd/private
BindReadOnlyPaths=%h/tramcast-app/releases/40e2adf %h/tramcast-app/app.env %h/tramcast/run

[Install]
WantedBy=default.target
