+func TestMLUnixAddress(t *testing.T) {
+	for _, address := range []string{
+		"unix:///home/bazevv/tramcast/run/forecast.sock",
+		"unix://relative/socket", "unix:///", "unix:///tmp/socket?query",
+		"unix:///tmp/socket#fragment", "unix:///tmp/%2Fsocket",
+	} {
+		t.Run(address, func(t *testing.T) {
+			cleanConfigEnv(t)
+			setRequiredEnv(t)
+			t.Setenv("ML_GRPC_ADDR", address)
+			cfg, err := Load("")
+			valid := address == "unix:///home/bazevv/tramcast/run/forecast.sock"
+			if valid {
+				if err != nil || cfg.ML.Addr != address {
+					t.Fatalf("valid Unix target rejected: %v", err)
+				}
+			} else if err == nil {
+				t.Fatal("invalid Unix target accepted")
+			}
+		})
+	}
+}
